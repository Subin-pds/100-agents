# Anthropic API key — required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# No key needed for navigate_to (Nominatim + Google Maps link) or
# get_weather (Open-Meteo) — both are free with no signup.

# YouTube Data API v3 — used for play_music (search + autoplay link).
# Free tier: 10,000 quota units/day, no billing account required.
# console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials -> API key.
YOUTUBE_API_KEY=

# Optional: override get_current_location's IP-geolocation guess, which
# resolves to your ISP's routing point rather than your actual device and
# can be tens of km off. Set this to wherever you actually are for testing.
JARVIS_LOCATION=

# Required on every /query request — the PWA prompts for this once and
# remembers it locally. Gates the whole API since Jarvis is deployed public
# (--allow-unauthenticated); without this anyone with the URL could burn
# API quota or, once document links are added below, fetch them.
JARVIS_PIN=

# Google Drive "anyone with the link" URLs for get_document. Leave blank to
# leave that document unavailable — the tool reports it as not configured
# rather than erroring. Treat these as sensitive: they open personal ID docs.
DOC_LICENSE_URL=
DOC_AADHAR_URL=
DOC_VEHICLE_RC_URL=
DOC_POLLUTION_URL=

# Trip log (log_trip tool + automatic GPS distance tracking) — one
# YYYY-MM-DD.md file per day in a Google Drive folder. See
# agent-6-jarvis/CLAUDE.md "Trip log" for the one-time setup:
#   1. console.cloud.google.com -> IAM & Admin -> Service Accounts ->
#      create one -> Keys -> Add key -> JSON. Save the file somewhere NOT
#      committed to git and point GOOGLE_SERVICE_ACCOUNT_FILE at it.
#   2. Create a Drive folder for the logs. Share it with the service
#      account's email (from the JSON's client_email) as Editor, and
#      separately with "Anyone with the link" as Viewer if you want to
#      read the files without going through the API.
#   3. Copy the folder ID from its URL
#      (drive.google.com/drive/folders/<THIS PART>) into
#      TRIP_LOG_DRIVE_FOLDER_ID below.
GOOGLE_SERVICE_ACCOUNT_FILE=
TRIP_LOG_DRIVE_FOLDER_ID=
