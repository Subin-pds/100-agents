GOOGLE_API_KEY=your-gemini-key
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Model selection (provider/model) ----
LLM_MODEL=gemini/gemini-2.5-flash
RESEARCH_MODEL=gemini/gemini-2.5-flash
ADVISOR_MODEL=gemini/gemini-2.5-flash
# ADVISOR_MODEL=anthropic/claude-sonnet-5   (paid, best reasoning)
# LLM_MODEL=ollama/qwen2.5:3b-instruct      (local, offline)

# Gemini fallback order, tried left to right on 429/503/504
FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest

# ---- LangSmith tracing (langgraph/ only; free key at smith.langchain.com) ----
# Traces (prompts, tool calls, outputs) are uploaded to LangSmith's cloud.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=agent-8-career-graph
