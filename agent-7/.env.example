# Required
ANTHROPIC_API_KEY=

# Optional — where transactions are stored (default: data/transactions.db)
FINANCE_DB_PATH=data/transactions.db

# Optional — override if your Obsidian vault isn't at the default path
OBSIDIAN_VAULT_PATH=C:\Users\subin\obsidianvault

# Optional — password for an encrypted statement PDF (most Indian bank
# statements are protected, often PAN or a bank-specific scheme).
# Alternatively pass --pdf-password on the ingest command per-run.
STATEMENT_PDF_PASSWORD=
